# Copy to postgres.env and update before running init.sh.
# init.sh always bootstraps PostgreSQL with these local development credentials.
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=netmark
# Host-side connection string after init.sh starts port-forwarding.
NETMARK_METRICS_SQL=postgresql://netmark:change-me@127.0.0.1:5433/netmark
