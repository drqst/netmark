# External metrics database. netmark writes nothing off this host until a
# connection string is set here or with: configure metrics <connection>.
# Run init.sh to bring up a local PostgreSQL and have it filled in for you.
metrics:
  sql: null
# Sending clients, each with its own id starting at 0. Manage with: client list |
# client add | client delete <id> | client <id> enable | client <id> remote <ip>.
clients:
  - id: 0
    enabled: false
    remote: 127.0.0.1
    runtime: null
    jitter_millis: null
    webrtc: null
# WebRTC data-channel layer on top of the selected transport. Toggle with:
# webrtc enable | webrtc disable. Each client's own `webrtc` field overrides it;
# null means follow this section.
webrtc:
  enabled: false
  channels: 1
  label: netmark
  ordered: true
admin:
  emails: []
# SMTP server used for alerts. Toggle with: admin smtp enabled | admin smtp disabled.
smtp:
  server: null
  enabled: false
# REST API. Toggle with: restapi enable | restapi disable. It is unauthenticated
# and can start traffic runs, so keep it on loopback unless it is fronted by an
# authenticating proxy.
restapi:
  enabled: false
  address: "127.0.0.1:8081"
